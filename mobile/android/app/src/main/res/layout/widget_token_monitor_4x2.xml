<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111522"
    android:padding="16dp"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Token Monitor"
            android:textColor="#38BDF8"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tv_updated_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="更新于 --:--"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日 AI 花费"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tv_today_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/tv_today_tokens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Tokens"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="#1E293B"
            android:layout_marginHorizontal="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Claude 额度"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tv_claude_quota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#10B981"
                android:textStyle="bold"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/tv_codex_quota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Codex: --"
                android:textColor="#F59E0B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
